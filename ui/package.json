{
  "name": "@bridge/ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun run check && bun --bun vite build",
    "check": "bun --bun tsc --noEmit",
    "test:e2e": "bun --bun playwright test",
    "test:container": "bun --bun playwright test --config container.playwright.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
