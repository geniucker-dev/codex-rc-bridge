# Copy to /etc/codex-rc-bridge/server.env and replace the origin with your HTTPS domain.
BRIDGE_DATABASE=/var/lib/codex-rc-bridge/bridge.sqlite
BRIDGE_MASTER_KEY=/etc/codex-rc-bridge-secrets/master.key
BRIDGE_PUBLIC_ORIGIN=https://bridge.example.com
BRIDGE_BIND=127.0.0.1:8787
BRIDGE_UI_DIR=/opt/codex-rc-bridge/ui
# Legacy bootstrap only: imported once when no saved network setting exists.
# Configure persistent proxy in setup or the deployment-admin Settings page.
# BRIDGE_UPSTREAM_PROXY=http://127.0.0.1:7890
