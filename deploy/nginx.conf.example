# nginx on the host terminates TLS and forwards the whole site to the bridge.
# Replace the hostname and certificate paths; the hostname must match BRIDGE_PUBLIC_ORIGIN.
server {
    listen 443 ssl;
    http2 on;
    server_name bridge.example.com;
    ssl_certificate     /etc/ssl/bridge.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/bridge.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8787;
        # Preserve the original Host, including any non-default public port.
        # The bridge checks it against BRIDGE_PUBLIC_ORIGIN.
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        # Live status uses server-sent events; buffering would hold them back.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
