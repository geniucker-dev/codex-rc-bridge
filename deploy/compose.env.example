# Copy to .env at the project root and set the HTTPS address your reverse proxy serves.
BRIDGE_PUBLIC_ORIGIN=https://bridge.example.com
# Optional: where the bridge listens on this host for the reverse proxy (default 127.0.0.1:8787).
# BRIDGE_HTTP_BIND=127.0.0.1
# BRIDGE_HTTP_PORT=8787
# Optional: run another image instead of the one compose.yaml names, such as a local build.
# BRIDGE_IMAGE=codex-rc-bridge-server:local
# Optional: reachable FROM THE CONTAINER, not the host loopback address.
# Optional legacy bootstrap; saved admin Settings take precedence.
# BRIDGE_UPSTREAM_PROXY=http://host.docker.internal:7890
